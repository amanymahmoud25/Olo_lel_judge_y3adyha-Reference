// ==================== COMBINATORICS & MODULAR ARITHMETIC ====================
// Precomputation: O(N) | Queries: O(1)
// REQUIREMENT: MOD must be a PRIME number (e.g., 1e9+7, 998244353)

#include <vector>

using namespace std;

typedef long long ll;

namespace combinatorics {
    ll MOD;
    vector<ll> fac, inv, finv;

    // Basic Modular Operations -> Time: O(1)
    ll add(ll a, ll b) { return ((a % MOD) + (b % MOD)) % MOD; }
    ll sub(ll a, ll b) { return (((a - b) % MOD) + MOD) % MOD; }
    ll mul(ll a, ll b) { return ((a % MOD) * (b % MOD)) % MOD; }

    // Fast Binary Exponentiation (b^n % MOD) -> Time: O(log N)
    ll power(ll b, ll n) {
        b %= MOD;
        ll res = 1;
        while (n > 0) {
            if (n & 1) res = (res * b) % MOD;
            b = (b * b) % MOD;
            n >>= 1;
        }
        return res;
    }

    // Modular Inverse using Fermat's Little Theorem -> Time: O(log MOD)
    ll Inv(ll x) { return power(x, MOD - 2); }
    ll divide(ll a, ll b) { return mul(a, Inv(b)); }

    // Precompute factorials & inverses up to N -> Time: O(N)
    void init(int n, ll mod) {
        MOD = mod;
        fac.assign(n + 1, 1);
        inv.assign(n + 1, 1);
        finv.assign(n + 1, 1);

        for (int i = 1; i <= n; i++) fac[i] = (fac[i - 1] * i) % MOD;
        for (int i = 2; i <= n; i++) inv[i] = MOD - (MOD / i) * inv[MOD % i] % MOD;
        for (int i = 2; i <= n; i++) finv[i] = (finv[i - 1] * inv[i]) % MOD;
    }

    // Combinations nCr -> Time: O(1)
    ll nCr(ll x, ll y) {
        if (x < 0 || y > x || y < 0) return 0;
        return fac[x] * finv[y] % MOD * finv[x - y] % MOD;
    }

    // Permutations nPr -> Time: O(1)
    ll nPr(ll x, ll y) {
        if (x < 0 || y > x || y < 0) return 0;
        return fac[x] * finv[x - y] % MOD;
    }

    // Stars and Bars Theorem -> Time: O(1)
    // Distribute n identical items into k distinct bins
    ll StarsAndPars(ll n, ll k) {
        if (n < 0 || k <= 0) return 0;
        return nCr(n + k - 1, k - 1);
    }

    // Catalan Number C_n -> Time: O(1)
    ll catalan(int n) {
        if (n < 0) return 0;
        return nCr(2 * n, n) * inv[n + 1] % MOD;
    }
};

using namespace combinatorics;
