void primes (int n ) {
        for (int i = 2; i * i <= n; i++)
        {
            int c = 0;
            while (n % i == 0)
            {
                c++; n /= i;
            }
           divs[i]+=c ;
        }
        if (n >1)
           divs[n]++;

    }
int n ,k ;
int fun (int indx , int sum) {
    if (indx==n+1) {
        return  (sum==1) ;
    }
    if (divs[indx]==0) return fun(indx+1,sum) ;
    int &ret  = dp[indx][sum] ;
    if (~ret) return ret ;

    int res =0;

    for (int i =0 ; i<=divs[indx] ;i++) {
        if (sum%(i+1)==0)
            res+= fun (indx+1,sum/(i+1));
        res %= 998244353 ;
    }
    return ret = res ;
}

