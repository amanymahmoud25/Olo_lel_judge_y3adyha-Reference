** binaryToDecimal 

long long binaryToDecimal(string bin) {
    long long dec = 0;
    long long base = 1; // 2^0 = 1
        for (int i = bin.length() - 1; i >= 0; i--) {
        if (bin[i] == '1') {
            dec += base;
        }
        base *= 2;  
    }
    return dec;
}

