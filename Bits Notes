Bit Prefix Sum (Prefix Count of Set Bits)

// prf[x][i] = number of integers from 1 to x  that have the i-th bit =1.
//(example: x=20000)

vector<vector<ll>> prf(200005, vector<ll>(31));

void cntBits() {
    for (int bit = 0; bit <= 30; bit ++) {
        for (int j = 1; j <= 200000; j++) {
            prf[j][ bit] = prf[j -1][ bit] + ((j >> bit)& 1);
        }
    }
}
Query
// Number of integers in [l, r]
// whose i-th bit = 1

prf[r][i] - prf[l - 1][i];
Time Complexity
•	Preprocessing: O(30 × N)
•	Each Query: O(1)

