**decimalToBinary

string decimalToBinary(long long dec) {
    if (dec == 0) return "0"; // حالة خاصة لو الرقم صفر
    string bin = "";
    while (dec > 0) {
        bin += to_string(dec % 2); 
        dec /= 2;
    }
        reverse(bin.begin(), bin.end());
    return bin;
}

