*** Remove Duplicates   O(N log⁡N )


string getUniqueString(string str) {  
sort(str.begin(), str.end()); 
auto res = unique(str.begin(), str.end()); 
return string(str.begin(), res);
 }

------------------------------------------------------------------------- 

*** Compressing Adjacent Duplicates O(N)


string getUniqueString(string str) {  
//sort(str.begin(), str.end()); 
auto res = unique(str.begin(), str.end()); 
return string(str.begin(), res);
 }


