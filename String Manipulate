لتقسيم النصوص***  (String Splitting)


string text = "dog cat cat dog"; 
vector<string> words; string word;
 // بنستخدم stringstream عشان نقرأ النص كلمة كلمة 
stringstream ss(text); 
// اللوب دي بتسحب كل كلمة مفصولة بمسافة وتحطها في الفيكتور 
while (ss >> word) {
 words.push_back(word);
 }

