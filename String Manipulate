*** Convert from string number  long long


string m;   cin >> m;
// نفصل الرقم عن الحرف الأخير ونحوله لـ long long
ll unit = stoll(m.substr(0, m.size() - 1));

// نفحص الحرف الأخير
if (m.back() == 'Gaga') unit *= 1024;
else if (m.back() == 'Tera') unit *= 1024 * 1024;
// لو كان M مش هنضرب في حاجة

