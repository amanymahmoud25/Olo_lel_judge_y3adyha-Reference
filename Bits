01 - Bit Manipulation (Merged & Optimized)
1. Basic Bit Operations
C++
// Get the bit value (0 or 1) at index idx
// Time: O(1) | Space: O(1)
int getBit(long long num, int idx) {
    return (num >> idx) & 1LL;
}

// Set bit at index idx to 1 (Returns modified value)
// Time: O(1) | Space: O(1)
long long setBit(long long num, int idx) {
    return num | (1LL << idx);
}

// Clear bit at index idx to 0 (Returns modified value)
// Time: O(1) | Space: O(1)
long long clearBit(long long num, int idx) {
    return num & ~(1LL << idx);
}

// Flip/Toggle bit at index idx (Returns modified value)
// Time: O(1) | Space: O(1)
long long flipBit(long long num, int idx) {
    return num ^ (1LL << idx);
}

// Pass-by-reference versions (In-place)
void setBitInPlace(long long &num, int idx)   { num |= (1LL << idx); }
void clearBitInPlace(long long &num, int idx) { num &= ~(1LL << idx); }
void flipBitInPlace(long long &num, int idx)  { num ^= (1LL << idx); }
2. Properties & Checks
C++
// Check if number is Even
// Time: O(1) | Space: O(1)
bool isEven(long long n) {
    return (n & 1) == 0;
}

// Check if number is Power of Two (Strictly positive numbers)
// Time: O(1) | Space: O(1)
bool isPowerOfTwo(long long num) {
    return num > 0 && !(num & (num - 1));
}
3. Counting Set Bits (Popcount)
C++
// Method 1: Brian Kernighan's Algorithm
// Time: O(Number of set bits) | Space: O(1)
int countOnes(long long n) {
    int cnt = 0;
    while (n) {
        cnt++;
        n &= (n - 1); // Clears the lowest set bit
    }
    return cnt;
}

// Method 2: GCC Built-in (Fastest - Recommended for Contests)
// Time: O(1) | Space: O(1)
int countOnesBuiltin(long long n) {
    return __builtin_popcountll(n); // Use __builtin_popcount for int
}
4. LSB & MSB Operations
C++
// Get the decimal value of the First Set Bit (LSB) -> e.g., 18 (10010) -> 2 (00010)
// Time: O(1) | Space: O(1)
long long firstOneVal(long long num) {
    return num & (-num); // Equivalent to num & ~(num - 1)
}

// Index of Rightmost Set Bit (LSB) -> e.g., 18 (10010) -> index 1 (Requires n > 0)
// Time: O(1) | Space: O(1)
int getLSBIndex(long long n) {
    return __builtin_ctzll(n); // ctz = Count Trailing Zeros
}

// Index of Leftmost Set Bit (MSB) -> e.g., 18 (10010) -> index 4 (Requires n > 0)
// Time: O(1) | Space: O(1)
int getMSBIndex(long long n) {
    return 63 - __builtin_clzll(n); // clz = Count Leading Zeros
    // Alternative in C++: return __lg(n);
}
5. Power of Two Utilities
C++
// Smallest power of 2 strictly greater than n (e.g., 5 -> 8, 8 -> 16)
// Time: O(1) | Space: O(1)
long long nextPowerOfTwo(long long n) {
    if (n <= 0) return 1;
    return 1LL << (__lg(n) + 1);
}

// Iterative version: O(log N)
long long nextPowerOfTwoIterative(long long n) {
    long long p = 1;
    while (p <= n) p <<= 1;
    return p;
}
6. Binary Printing & Formatting
C++
// Print Binary representation of n recursively
// Time: O(log N) | Space: O(log N) due to call stack
void printBinary(long long n) {
    if (n > 1) printBinary(n >> 1);
    cout << (n & 1);
}

