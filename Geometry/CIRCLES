/*
================================================================================
SECTION 6.5: CIRCLES
================================================================================
Overview:
Algorithms involving circles, circumcircles, circle intersections, and 
calculating overlap areas between circular regions.
*/

struct Circle {
    Point c;
    double r;
    Circle(Point c = Point(), double r = 0) : c(c), r(r) {}
};

// 6.5.2 Find circle passing through 3 points (Circumcircle)
Circle getCircumcircle(Point a, Point b, Point c) {
    Point d1 = b - a, d2 = c - a;
    double e1 = d1.x * (a.x + b.x) + d1.y * (a.y + b.y);
    double e2 = d2.x * (a.x + c.x) + d2.y * (a.y + c.y);
    double det = d1.x * d2.y - d1.y * d2.x;
    Point center((d2.y * e1 - d1.y * e2) / (2 * det), (d1.x * e2 - d2.x * e1) / (2 * det));
    return Circle(center, center.dist(a));
}

// 6.5.6 Circle Circle Intersection: Returns intersection points between two circles
vector<Point> intersectCircles(Circle c1, Circle c2) {
    double d = c1.c.dist(c2.c);
    if (d > c1.r + c2.r || d < fabs(c1.r - c2.r) || dcmp(d, 0) == 0) return {}; // No intersection or identical
    
    double a = (c1.r * c1.r - c2.r * c2.r + d * d) / (2 * d);
    double h = sqrt(max(0.0, c1.r * c1.r - a * a));
    
    Point p2 = c1.c + (c2.c - c1.c) * (a / d);
    Point r1(p2.x + h * (c2.c.y - c1.c.y) / d, p2.y - h * (c2.c.x - c1.c.x) / d);
    Point r2(p2.x - h * (c2.c.y - c1.c.y) / d, p2.y + h * (c2.c.x - c1.c.x) / d);
    
    if (r1.same(r2)) return {r1};
    return {r1, r2};
}

// 6.5.8 Circle Circle Intersection Area: Calculates intersection area of two circles
double circleIntersectionArea(Circle c1, Circle c2) {
    double d = c1.c.dist(c2.c);
    if (d >= c1.r + c2.r) return 0.0;
    if (d <= fabs(c1.r - c2.r)) {
        double r = min(c1.r, c2.r);
        return PI * r * r;
    }
    double alpha = 2 * acos((c1.r * c1.r + d * d - c2.r * c2.r) / (2 * c1.r * d));
    double beta  = 2 * acos((c2.r * c2.r + d * d - c1.r * c1.r) / (2 * c2.r * d));
    double a1 = 0.5 * c1.r * c1.r * (alpha - sin(alpha));
    double a2 = 0.5 * c2.r * c2.r * (beta - sin(beta));
    return a1 + a2;
}


