/*
================================================================================
SECTION 6.3 & 6.4: LINES AND SEGMENTS
================================================================================
Overview:
Operations on infinite lines and bounded line segments, including distance queries,
intersections, orientation tests (CCW), and segment checking.
*/

// 6.3.1 Is Collinear: Checks if 3 points lie on the same line
bool isCollinear(Point a, Point b, Point c) {
    return dcmp((b - a).cross(c - a), 0) == 0;
}

// 6.3.4 check if point p is between segment a, b
bool isPointOnSegment(Point p, Point a, Point b) {
    return isCollinear(a, b, p) && 
           dcmp(p.x, min(a.x, b.x)) >= 0 && dcmp(p.x, max(a.x, b.x)) <= 0 &&
           dcmp(p.y, min(a.y, b.y)) >= 0 && dcmp(p.y, max(a.y, b.y)) <= 0;
}

// 6.3.7 distToLine Min: Shortest distance from point P to infinite line AB
double distToLine(Point p, Point a, Point b) {
    Point v = b - a;
    return fabs(v.cross(p - a)) / a.dist(b);
}

// 6.3.8 & 6.4.1 distToSegment: Shortest distance from point P to bounded segment AB
double distToSegment(Point p, Point a, Point b) {
    Point v = b - a;
    if (dcmp((p - a).dot(v), 0) < 0) return p.dist(a); // Closest to point A
    if (dcmp((p - b).dot(v), 0) > 0) return p.dist(b); // Closest to point B
    return distToLine(p, a, b);                       // Perpendicular distance
}

// 6.4.5 CCW (Counter-Clockwise Test): 
// Returns +1 for CCW turn, -1 for CW turn, 0 for collinear
int ccw(Point a, Point b, Point c) {
    double cp = (b - a).cross(c - a);
    return dcmp(cp, 0);
}

// 6.4.3 intersectSegments: Checks if segment AB intersects segment CD
bool intersectSegments(Point a, Point b, Point c, Point d) {
    double cp1 = (b - a).cross(c - a), cp2 = (b - a).cross(d - a);
    double cp3 = (d - c).cross(a - c), cp4 = (d - c).cross(b - c);
    if (((cp1 > 0 && cp2 < 0) || (cp1 < 0 && cp2 > 0)) &&
        ((cp3 > 0 && cp4 < 0) || (cp3 < 0 && cp4 > 0))) return true;
    return isPointOnSegment(c, a, b) || isPointOnSegment(d, a, b) ||
           isPointOnSegment(a, c, d) || isPointOnSegment(b, c, d);
}


