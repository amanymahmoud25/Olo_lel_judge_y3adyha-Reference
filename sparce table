#include <bits/stdc++.h>
using namespace std;

#define ll long long
#define int ll

const int INF = 1e18; // تم تصحيح الـ INF

// هيكل مرن للـ Sparse Table يدعم أي عملية (GCD, AND, OR, MIN, MAX, SUM)
template <typename T, typename F>
struct SparseTable {
    int n, K;
    vector<vector<T>> st;
    vector<int> lg;
    F combine;

    SparseTable() {}

    SparseTable(const vector<T>& a, F op) : combine(op) {
        n = a.size();
        K = __lg(n) + 1;
        st.assign(n, vector<T>(K));
        lg.assign(n + 1, 0);

        // Precompute Log values
        for (int i = 2; i <= n; i++) lg[i] = lg[i / 2] + 1;

        // Base cases
        for (int i = 0; i < n; i++) st[i][0] = a[i];

        // Build Table -> O(N log N)
        for (int j = 1; j < K; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                st[i][j] = combine(st[i][j - 1], st[i + (1 << (j - 1))][j - 1]);
            }
        }
    }

    // O(1) Query for Idempotent operations (GCD, AND, OR, MIN, MAX)
    T query(int l, int r) {
        int j = lg[r - l + 1];
        return combine(st[l][j], st[r - (1 << j) + 1][j]);
    }

    // O(log N) Query for Non-Idempotent operations (SUM, XOR, etc.)
    T queryNonIdempotent(int l, int r, T identity = 0) {
        T res = identity;
        int sz = r - l + 1;
        for (int j = K - 1; j >= 0; j--) {
            if ((sz >> j) & 1) {
                res = combine(res, st[l][j]);
                l += (1 << j);
            }
        }
        return res;
    }
};

void solve() {
    vector<int> a = {12, 16, 24, 8, 36};

    // 1. Sparse Table للـ GCD
    auto gcd_op = [](int x, int y) { return std::__gcd(x, y); };
    SparseTable st_gcd(a, gcd_op);

    // 2. Sparse Table للـ Bitwise AND
    auto and_op = [](int x, int y) { return x & y; };
    SparseTable st_and(a, and_op);

    // الاستعلامات O(1)
    cout << "GCD [1, 3]: " << st_gcd.query(1, 3) << "\n"; // GCD(16, 24, 8) = 8
    cout << "AND [0, 2]: " << st_and.query(0, 2) << "\n"; // 12 & 16 & 24
}

signed main() {
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int t = 1;
    while (t--) {
        solve();
    }
    return 0;
}
