// ==================== SPARSE TABLE ====================
// Static Range Queries (RMQ, GCD, MAX)
// Build: O(N log N) | Query: O(1) for idempotent ops | Space: O(N log N)

#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>

using namespace std;

const int N = 2e5 + 5;
const int LOGN = 20;

ll s[N];
ll T[N][LOGN];
int Log[N];

// Operation function (min, max, gcd, etc.)
ll merge(ll a, ll b) {
    return min(a, b);
}

// Precompute log2 values up to N -> Time: O(N)
void preCount() {
    Log[1] = 0;
    for (int i = 2; i < N; i++) {
        Log[i] = Log[i >> 1] + 1;
    }
}

// Build Sparse Table -> Time: O(N log N)
void build(int n) {
    for (int i = 0; i < n; i++) {
        T[i][0] = s[i];
    }
    
    for (int pw = 1; (1 << pw) <= n; pw++) {
        for (int i = 0; i + (1 << pw) <= n; i++) {
            T[i][pw] = merge(T[i][pw - 1], T[i + (1 << (pw - 1))][pw - 1]);
        }
    }
}

// O(1) Query for Idempotent operations (min, max, gcd)
ll query2(int l, int r) {
    int sz = r - l + 1;
    int pw = Log[sz];
    return merge(T[l][pw], T[r - (1 << pw) + 1][pw]);
}

// O(log N) Query for Non-idempotent operations
ll query(int l, int r) {
    if (r < l) return LLONG_MAX;
    int sz = r - l + 1;
    for (int i = 0; i < LOGN; i++) {
        if ((sz >> i) & 1) {
            return merge(query(l + (1 << i), r), T[l][i]);
        }
    }
    return LLONG_MAX;
}
