int n , m ;
vector<vector<pair<int,int>>>adj ;
vector<int>dis ;
void Dijkstra() {
 priority_queue<pair<int,int> , vector<pair<int,int>> , greater<pair<int,int>>>pq ;
   pq.push({0,1}) ;
   while (!pq.empty()) {
       int node=pq.top().second ;
       int cost=pq.top().first ;
       pq.pop();
       if (cost > dis[node]) continue;
       for (auto [a,b] :adj[node]) {
           if (dis[a] > dis[node] + b) {
               dis[a] = dis[node] + b ;
               pq.push({dis[a],a}) ;
           }
       }
   }
}
void solve() {


   cin >>n >>m ;
   adj.resize(n+1,vector<pair<int,int>>()) ;
   for (int i=0 ; i<m ; i++) {
       int x,y,c ; cin >>x>>y>>c ;
       adj[x].push_back({y,c}) ;
   }
   dis.assign(n+1,inf) ;
   dis[1]=0 ;
   Dijkstra() ;
   for (int i=1;i<=n ; i++) cout <<dis[i] << ' ' ;
   cout <<endl;


}

