vector<bool>vis ;
vector<vector<int>>adj ;
void dfs(int node) {
   // O(n+m)
   vis[node]=1 ;


   for (int v :adj[node]) {
       if (vis[v]) continue;
       dfs(v) ;
   }
}
void solve() {
   // count component
    int n ,m ; cin >>n >> m;


   adj.assign(n+1,vector<int>()) ;
   vis.assign(n+1,false);
   for (int i=0 ; i<m ; i++) {
       int x , y ; cin >>x>>y ;
       adj[x].push_back(y) ;
       adj[y].push_back(x) ;
   }
int ans =0 ;
   for (int i =1 ; i<=n ; i++) {
       if (!vis[i]) {
           // cout << i << " " ;
           dfs(i) ;
           ans++;
       }
   }
   cout << ans << endl ;


}

