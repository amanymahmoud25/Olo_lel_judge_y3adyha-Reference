ll fastpow(ll x, ll n, ll mod) {
ll mod=1e9+7;
if (n == 0) return 1 % mod;
if (n == 1) return x % mod;
ll ans = fastpow (x, n / 2, mod);
ans = ans * ans % mod;
if (n & 1) ans = ans * x% mod;   // (x % mod) *(x%mod) % mod
return ans;
}


With loop:-
ll fastPow (ll x, ll n) {

    x %= mod;
    ll res = 1;
    while (n) {
        if (n & 1)
            res = res * x % mod;
        x = x * x % mod;    // (x % mod) *(x%mod) % mod
        n=n/2;
    }
    return res;
}

