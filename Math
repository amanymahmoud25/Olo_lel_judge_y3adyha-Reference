#define MAXN 100001
vector<int> spf(MAXN + 1, 1);
void SPF() {
    spf[0] = 0;
    for (int i = 2; i <= MAXN; i++) {
        if (spf[i] == 1) {
            for (int j = i; j <= MAXN; j += i) {
                if (spf[j]== 1) spf[j] = i;
            }
        }
