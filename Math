*** Prime Factorization

// Prints prime factors with their powers
// Time: O(√N)   to 10e12  sqrt=10e6 
// Space: O(log N) (عدد العوامل الأولية المختلفة).

vector<pair<int, int>> primeFact(int n) {
vector<pair<int, int>> ret;
for (auto& it : primes) {
if (it * it > n) break;  
if (n < sz(isPrime) - 1 && isPrime[n]) break;   // لو وصلت لرقم برايم
int cnt = 0;
while (n % it == 0) {
cnt++;
n /= it;
}
if (cnt) ret.push_back({ it, cnt });
}
if (n > 1)
ret.push_back({ n, 1}); 

return ret;
}

