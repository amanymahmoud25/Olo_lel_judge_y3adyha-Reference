*** triangle or segment or impossible 
// Triangle Inequality must satisfy ALL inequalities:  a+b>c && a+c>b && b+c>a
// Degenerate Triangle (Segment) if one side equals the sum of the other two:  a+b==c || a+c==b || b+c==a
// Impossible: Sum of two sides < third side.

bool triangle(ll a, ll b, ll c) {
    if (a <= 0 || b <= 0 || c <= 0)
        return false;
    return (a+b>c && a+c>b && b+c>a);
}
bool segment(ll a, ll b, ll c) {
    if (a <= 0 || b <= 0 || c <= 0)
        return false;

    return (a+b==c || a+c==b || b+c==a);
}
bool impossible(ll a, ll b, ll c) {
    if (a <= 0 || b <= 0 || c <= 0)
        return true;

    return (a+b<c || a+c<b || b+c<a);
}

