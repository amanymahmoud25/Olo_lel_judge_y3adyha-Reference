// Checks if n is prime
// Time: O(sqrt(N))
// Space: O(1)
bool isPrime(long long n) {
    if (n <= 2 || n%2==0 ) return false;
    for (long long i = 3; i * i <= n; i+=2) {
        if (n % i == 0) return false;
    }
    return true;
}

