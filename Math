*** Faster nCr 

// لو الناتج مش هيتخطي لونج لونج غير كدا هيدي اوفرفلو
// Time: O(r)   66C33  اقصي قيمه ممكن تتدخل
// Computes nCr without calculating 3 Factorials.
// الفكرة: نحسب البسط والمقام تدريجيًا (نضرب ثم نقسم في كل خطوة)
// لتجنب حساب Factorials الكبيرة.
// Space: O(1)


ll nCr(ll n, ll r) {
    if (r > n) return 0;
    r = min(r, n - r);

    ll ans = 1;

    for (ll i = 1; i <= r; i++) {
        ans *= (n - r + i);
        ans /= i;
    }

    return ans;
}

