*** Prime Factorization

// Time: O(√N)   to 10e12  sqrt=10e6 
// Space: O(log N) 

vector<pair<int, int>> primeFact(int n) {
vector<pair<int, int>> ret;
for (auto& it : primes) {
if (it * it > n) break;  
if (n < sz(isPrime) - 1 && isPrime[n]) break;
int cnt = 0;
while (n % it == 0) {
cnt++;
n /= it;
}
if (cnt) ret.push_back({ it, cnt });
}
if (n > 1)
ret.push_back({ n, 1}); 

return ret;
}

