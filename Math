*** Sum Powers


// Computes: x + x² + ... + xⁿ (mod mod)
// Technique: Divide & Conquer
// Recurrence:
//   Even: S(n) = S(n/2) * (1 + x^(n/2))
//   Odd : S(n) = S(n-1) + x^n
// Time: O(log²N) (بسبب fpow)
// Space: O(logN) (عمق الـ Recursion)

ll sumPower(11 x, 11 n, int mod) {
if (n == 1) return x % mod;
ll p = sumPower(x, n / 2, mod);
ll ans = p + (p * fpow(x, n /2, mod)%mod);
ans %= mod;
if (n & 1) ans += fpow(x, n, mod);
return ans % mod;
}

