*** Number of Divisors 

// Sqrt(N) Prime Factorization - Use for Large N up to 1e14 with small queries
// Number of Divisors
// If n = p1^e1 * p2^e2 * ... * pk^ek
// Answer = (e1+1)*(e2+1)*...(ek+1)
// Time: O(√n) (Trial Division)
// Time: O(n log log n) (Including Sieve)

ll numberOfDivisors(ll n) {
    sieve(n);
    ll x = n;
    map<ll,ll> freq;
    for (ll p : primes) {
        if (p * p > x) break;
        while (x % p == 0) {
            freq[p]++;
            x /= p;
        }
    }
    if (x > 1)
        freq[x]++;
    ll ans = 1;
    for (auto [prime, cnt] : freq)
        ans = ans * (cnt + 1);
    return ans;
}

