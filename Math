*** Modular Multiplicative Inverse (MMI)

// لازم لو في ارقام معمولها موديلس وهعملها قسمه استخدم القانون دا 
//  فنبدل عملية القسمة لضرب ونأتي برقم صحيح يعادل المقسوم عليه الفكرة: لأن الموديلس لا يتوزع ع القسمه
// Condition: mod is Prime & (B % mod != 0)
// Fermat's Little Theorem:
//      B^-1 = B^(mod - 2) % mod
// Division under Mod:
//      A / B % mod = (A * B^-1) % mod
// Time: O(log(mod)) (Binary Exponentiation)

ll fastPow (ll x, ll n) {

    x %= mod;
    ll res = 1;
    while (n) {
        if (n & 1)
            res = res * x % mod;
        x = x * x % mod;    // (x % mod) *(x%mod) % mod
        n=n/2;
    }
    return res;
}

ll modInverse(ll b) {
    return fastPow (b, mod - 2);
}
ll modDivide(ll a, ll b) {
    return (a % mod * modInverse(b)) % mod;
}

