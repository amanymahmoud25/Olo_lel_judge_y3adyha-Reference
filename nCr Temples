const ll MOD = 1e9 + 7;

/* =================================================================
   1. Exact nCr (بدون موديلو)
   - الوقت: O(r)
   - المساحة: O(1)
   
   * متى تستخدمه؟
     - لما المسألة **لا تطلب** باقي قسمة (Modulo).
     - لما تكون متأكد إن الناتج النهائي هيقدر يتخزن في long long (أقصى حاجة تقريباً 62C31).
     - ليه الكود ده ممتاز؟ لأنه بيستخدم __int128 عشان يمنع أي Overflow (تخطي مساحة الذاكرة) ممكن يحصل في النص أثناء عملية الضرب قبل القسمة.
====================================================================*/
ll nCr_Exact(ll n, ll r) {
    if (r < 0 || r > n) return 0;
    r = min(r, n - r);
    ll ans = 1;
    for (ll i = 1; i <= r; i++) {
        // استخدام __int128 بيحمي الكود من الـ Overflow المؤقت
        ans = (ll)((__int128)ans * (n - i + 1) / i);
    }
    return ans;
}


/* =================================================================
   * دوال مساعدة لحسابات الموديلو (تستخدم مع الطريقتين التانيين)
====================================================================*/
ll power(ll base, ll exp) {
    ll res = 1;
    base %= MOD;
    while (exp > 0) {
        if (exp % 2 == 1) res = (res * base) % MOD;
        base = (base * base) % MOD;
        exp /= 2;
    }
    return res;
}

ll modInverse(ll n) {
    return power(n, MOD - 2);
}


/* =================================================================
   2. Precomputed nCr (بالموديلو للـ N الصغيرة والمتوسطة)
   - الوقت: O(N) للتجهيز في البداية، O(1) لكل استعلام
   - المساحة: O(N)
   
   * متى تستخدمه؟
     - لما المسألة تطلب الناتج بـ **Modulo** (زي 1e9+7).
     - لما تكون قيمة N **صغيرة أو متوسطة** (أصغر من 2 * 10^6) عشان نقدر نحجزلها مصفوفة في الذاكرة بدون Memory Limit.
     - لما المسألة يكون فيها **عدد ضخم من الاستعلامات (Queries)** أو Testcases كتير جداً (زي 10^5)، لأن وقتها هتحتاج تجاوب على كل استعلام في وقت O(1) عشان تتجنب الـ TLE.
====================================================================*/
const int MAXN = 2e5 + 100; // عدل الحجم ده بناءً على قيود المسألة
ll fact[MAXN], inv[MAXN], invfact[MAXN];

// الدالة دي بتستدعيها مرة واحدة بس في الـ main قبل الـ Testcases
void factInverse() {
    fact[0] = inv[1] = fact[1] = invfact[0] = invfact[1] = 1;
    for (long long i = 2; i < MAXN; i++) {
        fact[i] = (fact[i - 1] * i) % MOD;
        inv[i] = MOD - (inv[MOD % i] * (MOD / i) % MOD);
        invfact[i] = (inv[i] * invfact[i - 1]) % MOD;
    }
}

// دي الدالة اللي بتستدعيها جوه الكود عشان تجيب الإجابة
ll nCr_Pre(int n, int r) {
    if (r < 0 || r > n) return 0;
    return (((fact[n] * invfact[r]) % MOD) * invfact[n - r]) % MOD;
}


/* =================================================================
   3. Huge N, Small R (بالموديلو للـ N العملاقة)
   - الوقت: O(r) لكل استعلام
   - المساحة: O(1)
   
   * متى تستخدمه؟
     - لما المسألة تطلب الناتج بـ **Modulo**.
     - لما تكون قيمة N **عملاقة جداً** (تصل لـ 10^18)، وبالتالي مستحيل نعملها مصفوفة (Array).
     - لازم تكون قيمة R **صغيرة نسبياً** (تصل لـ 10^6)، لأن الكود بيعمل Loop بتلف R مرة.
     - يُفضل لما يكون عدد الـ Testcases قليل (لو الـ Testcases كتير جداً والـ R كبيرة، ممكن يجيب TLE).
====================================================================*/
ll nCr_Huge(ll n, ll r) {
    if (r < 0 || r > n) return 0;
    r = min(r, n - r);
    
    ll num = 1; // لحساب البسط
    ll den = 1; // لحساب المقام
    
    for (ll i = 1; i <= r; i++) {
        num = (num * ((n - i + 1) % MOD)) % MOD;
        den = (den * i) % MOD;
    }
    
    // بنستدعي المعكوس الضربي مرة واحدة بس برا اللوب عشان نحمي الكود من الـ TLE
    return (num * modInverse(den)) % MOD;
}
