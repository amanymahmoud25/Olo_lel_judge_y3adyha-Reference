** BFS Standard


// Visits nodes level by level.
// Finds the shortest path in an unweighted graph.
// Time: O(V + E)  Space: O(V)

vector<vector<int>> adj;
vector<bool> vis;
queue<int> q;

void bfs(int src){
    vis.assign(adj.size(), false);

    q.push(src);
    vis[src] = true;

    while(!q.empty()){
        int node = q.front();
        q.pop();

        // Process node

        for(auto child : adj[node]){
            if(vis[child]) continue;

            vis[child] = true;
            q.push(child);
        }
    }
}
