** Topological Sort  With BFS Kahn algorithm


void TopologicalSort() {
    int n, m; // n = عدد النودز، m = عدد الحواف (Edges)
    cin >> n >> m;

    vector<vector<int>> adj(n + 1); // الـ Adjacency List
    vector<int> in_degree(n + 1, 0); // مصفوفة لحساب عدد الأسهم الداخلة لكل نود

    // 1. بناء الجراف وحساب الـ in-degree
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v); // سهم من u إلى v
        in_degree[v]++;      // النود v دخلها سهم جديد
    }

    // 2. وضع النودز التي ليس لها أي شروط مسبقة (in_degree == 0) في الطابور
    queue<int> q;
    for (int i = 1; i <= n; i++) {
        if (in_degree[i] == 0) {
            q.push(i);
        }
    }

    // 3. استخراج الترتيب التوبولوجي
    vector<int> topo_order;
    while (!q.empty()) {
        int curr = q.front();
        q.pop();
        topo_order.push_back(curr);

        // المرور على جيران النود الحالية وحذف السهم اللي بينهم
        for (int neighbor : adj[curr]) {
            in_degree[neighbor]--; // قللنا الـ in-degree بواحد لأننا خلصنا الأب
            if (in_degree[neighbor] == 0) {
                q.push(neighbor); // لو النود بقت جاهزة، ندخلها الطابور
            }
        }
    }

    // 4. التحقق من وجود Cycle (دورة مغلقة)
    if (topo_order.size() != n) {
        cout << "Cycle detected! Topological sort is not possible.\n";
    } else {
        // طباعة الترتيب
        for (int node : topo_order) {
            cout << node << " ";
        }
        cout << "\n";
    }

    return 0;
}

