** DFS (Recursive)


N=nodes , m= Vertices    O(n+m)
	اللون 0 (أبيض): العقدة لم تُزر بعد.
	اللون 1 (رمادي): دخلنا العقدة ونستكشف جيرانها (لم ننتهِ منها).
	اللون 2 (أسود): انتهينا من العقدة ومن جميع جيرانها وخرجنا منها.
	كما نسجل وقت الدخول time_in ووقت الخروج time_out
void dfs(int v) {
    time_in[v] = dfs_timer++; // نسجل وقت الدخول
    color[v] = 1; // نلونها بالرمادي (قيد الاستكشاف)
    
    for (int u : adj[v])
        if (color[u] == 0) // لو الجار أبيض (لم يُزر)
            dfs(u); // نتعمق فيه
            
    color[v] = 2; // بعد الانتهاء من كل الجيران، نلونها بالأسود (انتهت)
    time_out[v] = dfs_timer++; // نسجل وقت الخروج
}
