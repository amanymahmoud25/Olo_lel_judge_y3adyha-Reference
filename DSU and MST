DSU

class DSU {
    private:
        vector<int>p, sz;
        vector<pair<int &, int>>history;
    public:
        DSU(int n) : p(n+1),sz(n+1,1){
            iota(all(p),0);
        }
        int get(int x){
            if(p[x] == x)return x;
            return p[x] = get(p[x]);
        }
       
        void merge(int a , int b){
            a = get(a);
            b = get(b);
            if(a == b)return ;
            if(sz[a] < sz[b])swap(a,b);
            history.push_back({p[b],p[b]});
            history.push_back({sz[a],sz[a]});
            p[b] = a;
            sz[a] += sz[b];
        }


        void rollback(){
            history.back().first = history.back().second;
            history.pop_back();
            history.back().first = history.back().second;
            history.pop_back();
        }
       
};

MST : Kruksal's  (Sorting & DSU)

struct Edge {
    int u, v, weight;
    bool operator<(Edge const& other) {
        return weight < other.weight;
    }
};
int main(){
    int n;
    vector<Edge> edges;
    int cost = 0;
    vector<Edge> result;
    sort(edges.begin(), edges.end());
    DSU dsu(n);
    for (Edge e : edges) {
        if(dsu.get(e.u) != dsu.get(e.v)){
            cost += e.weight;
            result.push_back(e);
            dsu.merge(e.u,e.v);
        }
    }
}

MST : Prim (Priority Queue + Visited)

    int n, m;
    cin >> n >> m;


    vector<vector<pair<int, int>>> adj(n + 1);


    for (int i = 0; i < m; i++) {
        int u, v, w;
        cin >> u >> v >> w;


        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }


    vector<bool> vis(n + 1, false);


    // {weight, vertex}
    priority_queue<
        pair<int, int>,
        vector<pair<int, int>>,
        greater<pair<int, int>>
    > pq;


    // Start from vertex 1
    pq.push({0, 1});


    int mstCost = 0;
    int edges = 0;


    while (!pq.empty()) {
        auto [w, u] = pq.top();
        pq.pop();


        if (vis[u])
            continue;


        vis[u] = true;


        mstCost += w;
        edges++;


        for (auto [v, weight] : adj[u]) {
            if (!vis[v]) {
                pq.push({weight, v});
            }
        }
    }


    // If graph is disconnected, MST doesn't exist
    if (edges != n) {
        cout << "MST doesn't exist\n";
    } else {
        cout << mstCost << '\n';
    }

