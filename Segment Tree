*****  Recursive Segment Tree

#include <vector>
#include <algorithm>
#include <climits>
#include <iostream>

using namespace std;

template <typename T>
struct RecursiveSegTree {
private:
    vector<T> seg;
    int sz;
    T skip; // Neutral element

    T merge(T a, T b) {
        return min(a, b); // غير هذه الدالة حسب المسألة (min, max, sum, gcd)
    }

    void build(const vector<T>& a, int l, int r, int node) {
        if (l == r) {
            if (l < a.size()) seg[node] = a[l];
            return;
        }
        int mid = (l + r) >> 1;
        build(a, l, mid, 2 * node + 1);
        build(a, mid + 1, r, 2 * node + 2);
        seg[node] = merge(seg[2 * node + 1], seg[2 * node + 2]);
    }

    void update(int l, int r, int node, int idx, T val) {
        if (l == r) {
            seg[node] = val;
            return;
        }
        int mid = (l + r) >> 1;
        if (idx > mid) {
            update(mid + 1, r, 2 * node + 2, idx, val);
        } else {
            update(l, mid, 2 * node + 1, idx, val);
        }
        seg[node] = merge(seg[2 * node + 1], seg[2 * node + 2]);
    }

    T query(int l, int r, int node, int lx, int rx) {
        if (l > rx || r < lx) return skip;      // No overlap
        if (l >= lx && r <= rx) return seg[node]; // Total overlap
        
        int mid = (l + r) >> 1;                 // Partial overlap
        T a = query(l, mid, 2 * node + 1, lx, rx);
        T b = query(mid + 1, r, 2 * node + 2, lx, rx);
        return merge(a, b);
    }

public:
    RecursiveSegTree(int n, T skip_val = INT_MAX) {
        skip = skip_val;
        sz = 1;
        while (sz < n) sz <<= 1;
        seg.assign(sz << 1, skip);
    }

    void build(const vector<T>& a) {
        build(a, 0, sz - 1, 0);
    }

    void update(int idx, T val) {
        update(0, sz - 1, 0, idx, val);
    }

    T query(int l, int r) {
        return query(0, sz - 1, 0, l, r);
    }
};



    امثله للاستخدام :-

    vector<long long> a = {5, 2, 8, 1, 9, 3, 7, 4};
    int n = a.size();

    // 1. استخدام القالب الأول (Recursive)
    // نمرر الحجم، والقيمة المحايدة (INT_MAX للمينيمم)
    RecursiveSegTree<long long> recTree(n, 1e18); 
    recTree.build(a); // بناء الشجرة في O(N)

    cout << "Recursive Tree:" << endl;
    cout << "Min from index 1 to 4: " << recTree.query(1, 4) << endl; // النطاق [2, 8, 1, 9] -> الناتج 1
    
    recTree.update(3, 10); // تعديل العنصر في الإندكس 3 من (1) إلى (10)
    cout << "Min from index 1 to 4 after update: " << recTree.query(1, 4) << endl; // النطاق [2, 8, 10, 9] -> الناتج 2


    
