*****  Iterative Segment Tree 


template <typename T>
struct IterativeSegTree {
    int n;
    vector<T> tree;
    T skip;

    T merge(T a, T b) {
        return min(a, b); // غير هذه الدالة حسب المسألة
    }

    IterativeSegTree(int n, T skip_val = INT_MAX) : n(n), skip(skip_val) {
        tree.assign(2 * n, skip);
    }

    void build(const vector<T>& a) {
        for (int i = 0; i < n; i++) tree[n + i] = a[i];
        for (int i = n - 1; i > 0; --i) 
            tree[i] = merge(tree[i << 1], tree[i << 1 | 1]);
    }

    void update(int pos, T value) {
        for (tree[pos += n] = value; pos > 1; pos >>= 1)
            tree[pos >> 1] = merge(tree[pos], tree[pos ^ 1]);
    }

    T query(int l, int r) {
        T resL = skip, resR = skip;
        for (l += n, r += n + 1; l < r; l >>= 1, r >>= 1) {
            if (l & 1) resL = merge(resL, tree[l++]);
            if (r & 1) resR = merge(tree[--r], resR);
        }
        return merge(resL, resR);
    }
};


امثله للاستخدام :-

int main() {
    // مصفوفة ابتدائية
    vector<long long> a = {5, 2, 8, 1, 9, 3, 7, 4};
    int n = a.size();


    // استخدام (Iterative)
    IterativeSegTree<long long> iterTree(n, 1e18);
    iterTree.build(a); // بناء الشجرة

    cout << "Iterative Tree:" << endl;
    cout << "Min from index 1 to 4: " << iterTree.query(1, 4) << endl; 
    
    iterTree.update(3, 10); // تعديل الإندكس 3
    cout << "Min from index 1 to 4 after update: " << iterTree.query(1, 4) << endl; 

    return 0;
}
