*** 15. Circle-Circle Intersection — تقاطع دائرتين

بيعمل إيه؟
- بيحدد عدد نقاط التقاطع بين دائرتين.

أستخدمه إمتى؟
- لما يكون عندي:
    Circle 1: center C1, radius r1
    Circle 2: center C2, radius r2

احسب:

d = distance(C1, C2)

ثم:

d > r1+r2
→ لا يوجد تقاطع

d < |r1-r2|
→ دائرة داخل الأخرى بدون تقاطع

d = r1+r2
→ Tangent خارجي
→ نقطة واحدة

d = |r1-r2|
→ Tangent داخلي
→ نقطة واحدة

|r1-r2| < d < r1+r2
→ نقطتان

Time: O(1)
*/


int circleRelation(
    pt c1,
    T r1,
    pt c2,
    T r2
) {
    T d = dist(c1, c2);

    if (d > r1 + r2)
        return 0; // No intersection

    if (d < abs(r1 - r2))
        return 0; // One inside another

    if (d == r1 + r2 ||
        d == abs(r1 - r2))
        return 1; // Tangent

    return 2;     // Two intersections
}
