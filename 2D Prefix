*** 2D Prefix Sum


// pre[i][j] = Sum of rectangle from (1,1) to (i,j).
//
// Formula:
// pre[i][j] = val
//           + pre[i-1][j]      // Upper Rectangle
//           + pre[i][j-1]      // Left Rectangle
//           - pre[i-1][j-1]    // Remove Overlap (Inclusion-Exclusion)
//
// Why subtract pre[i-1][j-1]?
// لأنه تم جمع منطقة التقاطع مرتين (مرة مع المستطيل العلوي ومرة مع المستطيل الأيسر)، فنطرحها مرة واحدة
// Time: Build    O(n*m) Query   -> O(1)
vector<vector<ll>> pre(n + 1, vector<ll>(m + 1, 0));

for (int i = 1; i <= n; i++) {
    for (int j = 1; j <= m; j++) {
        ll val=(xxx);
        pre[i][j] = val
                  + pre[i-1][j]
                  + pre[i][j-1]
                  - pre[i-1][j-1];
    }
}

auto query =[&] (int x1,int y1,int x2,int y2){
    return pre[x2][y2]
         - pre[x1-1][y2]
         - pre[x2][y1-1]
         + pre[x1-1][y1-1];
};

