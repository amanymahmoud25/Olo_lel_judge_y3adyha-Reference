4. الخوارزميات الشائعة مع الاسترينج (Algorithms)
C++
string s = "codeforces";

// O(N) - عكس الاسترينج
reverse(s.begin(), s.end());

// O(N log N) - ترتيب الحروف أبجدياً
sort(s.begin(), s.end());

// O(N) - تحويل الاسترينج لـ Lowercase
for (char &c : s) c = tolower(c);

// O(N) - تحويل الاسترينج لـ Uppercase
for (char &c : s) c = toupper(c);

