Note:----
// لو مفيش عنصر بيحقق الشرط، القيمة بتفضل -1
(أو ممكن تخليها n حسب المسألة)

-------------------------------------------------

**** Next Greater Element (NGE)
// أول عنصر أكبر على اليمين


vector<int> get_NGE(const vector<int>& a) {
    int n = sz(a);
    vector<int> nge(n, -1);
    stack<int> st;
    for (int i = 0; i < n; i++) {
        while (!st.empty() && a[st.top()] < a[i]) {
            nge[st.top()] = i;
            st.pop();
        }
        st.push(i);
    }
    return nge;
}

-------------------------------------------------

**** Next Smaller Element (NSE)
// أول عنصر أصغر على اليمين


vector<int> get_NSE(const vector<int>& a) {
    int n = sz(a);
    vector<int> nse(n, -1);
    stack<int> st;
    for (int i = 0; i < n; i++) {
        while (!st.empty() && a[st.top()] > a[i]) {
            nse[st.top()] = i;
            st.pop();
        }
        st.push(i);
    }
    return nse;
}

-------------------------------------------------

**** Previous Greater Element (PGE)
// أول عنصر أكبر على الشمال


vector<int> get_PGE(const vector<int>& a) {
    int n = sz(a);
    vector<int> pge(n, -1);
    stack<int> st;
    for (int i = 0; i < n; i++) {
        while (!st.empty() && a[st.top()] <= a[i]) {
            st.pop();
        }
        if (!st.empty()) {
            pge[i] = st.top();
        }
        st.push(i);
    }
    return pge;
}

-------------------------------------------------

**** Previous Smaller Element (PSE)
// أول عنصر أصغر على الشمال


vector<int> get_PSE(const vector<int>& a) {
    int n = sz(a);
    vector<int> pse(n, -1);
    stack<int> st;
    for (int i = 0; i < n; i++) {
        while (!st.empty() && a[st.top()] >= a[i]) {
            st.pop();
        }
        if (!st.empty()) {
            pse[i] = st.top();
        }
        st.push(i);
    }
    return pse;
}
