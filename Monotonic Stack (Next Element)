**** Previous Smaller Element (PSE)

// بيرجع مصفوفة فيها الـ Index بتاع أول عنصر أصغر من العنصر الحالي على الشمال


vector<int> get_PSE(const vector<int>& a) {
    int n = sz(a);
    vector<int> pse(n, -1);
    stack<int> st;

    for (int i = 0; i < n; i++) {
        // بنشيل كل العناصر اللي أكبر من أو تساوي العنصر الحالي
        while (!st.empty() && a[st.top()] >= a[i]) {
            st.pop();
        }
        // لو الـ Stack لسه فيه عناصر، يبقى اللي على الوش هو أول عنصر أصغر
        if (!st.empty()) {
            pse[i] = st.top();
        }
        st.push(i);
    }
    return pse;
}

