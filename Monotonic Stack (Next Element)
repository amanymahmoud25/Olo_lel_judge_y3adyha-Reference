
***  Next Greater Element (NGE)

// بيرجع مصفوفة فيها الـ Index بتاع أول عنصر أكبر من العنصر الحالي على اليمين
// لو مفيش عنصر أكبر، القيمة بتفضل -1 (أو ممكن تخليها n حسب المسألة)

vector<int> get_NGE(const vector<int>& a) {
    int n = sz(a);
    vector<int> nge(n, -1);
    stack<int> st;

    for (int i = 0; i < n; i++) {
        // طول ما الـ Stack مش فاضي والعنصر الحالي أكبر من العنصر اللي فوق في الـ Stack
        while (!st.empty() && a[st.top()] < a[i]) {
            nge[st.top()] = i;
            st.pop();
        }
        st.push(i);
    }
    return nge;
}

